#!/bin/bash

# omarchy:summary=Paste Voxtype dictation through Hyprland
# omarchy:args=<begin|end>
# omarchy:hidden=true

# Voxtype runs `begin` as its pre_output_command and `end` as its
# post_output_command. In clipboard mode it only copies the transcript, and
# `end` pastes it with Shift+Insert from Hyprland, which XWayland apps receive
# intact where wtype's typing arrives as Escape and digits. Voxtype also runs
# post_output_command after cancelled and empty recordings, so `end` pastes
# only after a `begin`. Type and paste modes deliver the text themselves, so
# `begin` arms nothing there.

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
marker="$runtime_dir/omarchy-voxtype-output"

daemon_identity() {
  local pid process_stat
  local stat_fields=()

  # Voxtype writes this before running hooks, including for manual launches.
  # Hook shell PIDs change on each call; the daemon's PID and start time do not.
  [[ -r $runtime_dir/voxtype/pid ]] || return 1
  pid=$(<"$runtime_dir/voxtype/pid") || return 1
  [[ $pid =~ ^[1-9][0-9]*$ && -r /proc/$pid/stat ]] || return 1
  process_stat=$(</proc/"$pid"/stat) || return 1
  read -r -a stat_fields <<<"${process_stat##*) }"
  [[ ${stat_fields[0]} != "Z" && ${stat_fields[19]:-} =~ ^[0-9]+$ ]] || return 1
  printf '%s:%s\n' "$pid" "${stat_fields[19]}"
}

case "${1:-}" in
  begin)
    if [[ $(voxtype config get output.mode) == "clipboard" ]] && identity=$(daemon_identity); then
      printf '%s\n' "$identity" > "$marker"
    else
      rm -f "$marker"
    fi
    ;;
  end)
    if [[ -f $marker ]]; then
      pending=$(<"$marker")
      rm -f "$marker"
      # A marker left by a dead daemon must not paste on the next cancellation.
      if identity=$(daemon_identity) && [[ $pending == "$identity" ]]; then
        # Voxtype's own paste mode gives the clipboard as long to settle.
        sleep 0.1
        omarchy-hyprland-send-shortcut SHIFT Insert
      fi
    fi
    ;;
  *)
    echo "Usage: omarchy-voxtype-output <begin|end>" >&2
    exit 1
    ;;
esac
